# Copy is created by configure.sh. Never commit the real file. Values below are placeholders.
TRADEBOT_BROKER=trading212             # trading212 | alpaca | sim
TRADEBOT_MARKET_DATA=auto              # auto | alpaca | replay
ALPACA_DATA_FEED=iex                   # iex (free) | sip (paid subscription)
ALPACA_PAPER_KEY_ID=                   # with trading212: data-only Alpaca paper account (no funding)
ALPACA_PAPER_SECRET=
ALPACA_LIVE_KEY_ID=                    # leave empty until you intend to go live
ALPACA_LIVE_SECRET=
T212_DEMO_KEY_ID=
T212_DEMO_SECRET=
T212_LIVE_KEY_ID=
T212_LIVE_SECRET=
FINNHUB_API_KEY=                       # trading212: delayed London ETF price for sizing
# TRADEBOT_EXECUTION_MAP={"SPY":{"isin":"IE00B3XXRP09","label":"VUSA","reference_symbol":"VUSA.L"}}
TRADEBOT_ADMIN_PASSWORD_HASH=          # argon2 hash from: python -m tradebot.cli hash-password
TRADEBOT_TOTP_SECRET=                  # optional, from: python -m tradebot.cli totp-setup
TRADEBOT_ALLOWED_ORIGIN=               # e.g. https://bot.example.com
TRADEBOT_DOMAIN=                       # for the Caddy HTTPS proxy (public profile)
NTFY_URL=                              # e.g. https://ntfy.sh/<long-random-topic>
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HEALTHCHECK_PING_URL=                  # e.g. https://hc-ping.com/<uuid> (alerts if the bot stops)
ANTHROPIC_API_KEY=                     # optional; leave empty = AI news assessment off
TRADEBOT_AI_MODEL=claude-opus-5
TRADEBOT_AI_DAILY_BUDGET_USD=0.50
TRADEBOT_INFRA_COST_GBP_MONTH=4.50     # attributed to daily reports
TRADEBOT_DATA_COST_GBP_MONTH=0
